# ==============================================================================
# Mandi+ Platform - Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this template to '.env' at the project root:
#    cp .env.example .env (Linux/macOS) or copy .env.example .env (Windows)
# 2. Fill in your actual local or hosted credentials in '.env'.
# 3. DO NOT commit '.env' to Git or publish secrets to GitHub.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend Server Configuration
# ------------------------------------------------------------------------------
SERVER_PORT=8082

# ------------------------------------------------------------------------------
# 2. MySQL / Hosted Database Credentials (BACKEND ONLY - NEVER EXPOSE TO FRONTEND)
# ------------------------------------------------------------------------------
# For local MySQL:
DB_URL=jdbc:mysql://localhost:3306/mandiplus_db
DB_USERNAME=root
DB_PASSWORD=your_local_mysql_password_here

# For hosted database (e.g., Aiven, AWS RDS, Clever Cloud):
# DB_URL=jdbc:mysql://your-db-host.aivencloud.com:12345/defaultdb?ssl-mode=REQUIRED
# DB_USERNAME=avnadmin
# DB_PASSWORD=your_hosted_db_password_here

# ------------------------------------------------------------------------------
# 3. JWT Authentication Security (BACKEND ONLY)
# Must be at least 256 bits (32 characters or Base64 encoded)
# Generate via: openssl rand -base64 32
# ------------------------------------------------------------------------------
JWT_SECRET=your_jwt_signing_secret_minimum_32_characters_here
JWT_EXPIRATION_MS=86400000

# ------------------------------------------------------------------------------
# 4. Razorpay Escrow Gateway Credentials
# ------------------------------------------------------------------------------
# Public Key ID (used by backend and client modal)
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id_here
# Privileged Secret (BACKEND ONLY - NEVER EXPOSE TO FRONTEND)
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here
# Optional Webhook Secret (from Razorpay Webhook Dashboard)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ------------------------------------------------------------------------------
# 5. Government Mandi API (data.gov.in / AGMARKNET - BACKEND ONLY)
# Portal: https://www.data.gov.in/
# Resource ID: 9ef84268-d588-465a-a308-a864a43d0070
# ------------------------------------------------------------------------------
DATA_GOV_IN_API_KEY=your_data_gov_in_api_key_here

# ------------------------------------------------------------------------------
# 6. SMS OTP Authentication (Indian SMS Gateway - BACKEND ONLY)
# Supported Providers: mock | fast2sms
# ------------------------------------------------------------------------------
MANDIPLUS_OTP_PROVIDER=fast2sms
MANDIPLUS_OTP_API_KEY=your_fast2sms_api_key_here

# ------------------------------------------------------------------------------
# 7. Firebase Authentication & Service Account
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=mandiplus
# Optional path to service account JSON (BACKEND ONLY - DO NOT COMMIT JSON FILES)
FIREBASE_SERVICE_ACCOUNT_PATH=

# ------------------------------------------------------------------------------
# 8. Frontend Public Configuration (Browser-Accessible Variables)
# NOTE: Variables prefixed with 'VITE_' are bundled into client-side JavaScript.
# NEVER put passwords, private tokens, or backend signing keys in VITE_* variables.
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:8082/api
VITE_WS_PORT=8082

# Geoapify Maps & Reverse Geocoding API Key (Restricted to your domain in Geoapify console)
VITE_GEOAPIFY_API_KEY=your_geoapify_browser_api_key_here

# OpenWeatherMap API Key (Optional; client falls back to Open-Meteo if left blank)
VITE_OPENWEATHER_API_KEY=your_openweather_api_key_here

# Razorpay Browser Key ID
VITE_RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id_here

# Firebase Web Client Configuration (Safe public client identifiers)
VITE_FIREBASE_API_KEY=your_firebase_web_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=mandiplus.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=mandiplus
VITE_FIREBASE_STORAGE_BUCKET=mandiplus.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_firebase_app_id_here
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id_here
OPENWEATHER_API_KEY=
