# ==============================================================================
# Mandi+ Platform - Frontend Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this template to '.env' inside the 'frontend/' folder:
#    cp .env.example .env (Linux/macOS) or copy .env.example .env (Windows)
# 2. These variables are exposed to the browser via Vite.
#
# CRITICAL SECURITY RULE:
# NEVER place backend database credentials, passwords, JWT signing secrets,
# Razorpay secrets, or private API tokens in this file.
# Vite bundles ALL 'VITE_*' variables into publicly downloadable JavaScript!
# ==============================================================================

# Backend API Endpoint & WebSocket Port
VITE_API_URL=http://localhost:8082/api
VITE_WS_PORT=8082

# Geoapify Maps & Geocoding Client Key
# (Create a free project at https://www.geoapify.com/ and configure HTTP Referrer domain restrictions)
VITE_GEOAPIFY_API_KEY=your_geoapify_browser_api_key_here

# OpenWeatherMap Client API Key (Optional - application automatically falls back to Open-Meteo if left empty)
VITE_OPENWEATHER_API_KEY=your_openweather_api_key_here

# Razorpay Browser Checkout Key ID (Public Client Identifier only, e.g. rzp_test_*)
VITE_RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id_here

# Firebase Web Client Configuration (Public Browser App Credentials)
VITE_FIREBASE_API_KEY=your_firebase_web_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=mandiplus.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=mandiplus
VITE_FIREBASE_STORAGE_BUCKET=mandiplus.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_firebase_app_id_here
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id_here
